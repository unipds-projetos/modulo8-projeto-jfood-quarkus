            </column>
        </createTable>
        <addUniqueConstraint columnNames="pedido_id" constraintName="avaliacao_pedido_id_key" tableName="avaliacao" />
    </changeSet>

    <!-- As FKs no fim, como no SQL: assim a ordem dos CREATE nao importa -->
<changeSet id="1-foreign-keys" author="jfood" labels="schema">
        <addForeignKeyConstraint baseColumnNames="cliente_id" baseTableName="avaliacao" constraintName="fk_avaliacao_cliente" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="usuario_id" referencedTableName="cliente" validate="true" />
        <addForeignKeyConstraint baseColumnNames="pedido_id" baseTableName="avaliacao" constraintName="fk_avaliacao_pedido" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="pedido" validate="true" />
        <addForeignKeyConstraint baseColumnNames="restaurante_id" baseTableName="avaliacao" constraintName="fk_avaliacao_restaurante" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="restaurante" validate="true" />
        <addForeignKeyConstraint baseColumnNames="usuario_id" baseTableName="cliente" constraintName="fk_cliente_usuario" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="usuario" validate="true" />
        <addForeignKeyConstraint baseColumnNames="usuario_id" baseTableName="dono_restaurante" constraintName="fk_dono_usuario" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="usuario" validate="true" />
        <addForeignKeyConstraint baseColumnNames="cliente_id" baseTableName="endereco_entrega" constraintName="fk_endereco_cliente" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="usuario_id" referencedTableName="cliente" validate="true" />
        <addForeignKeyConstraint baseColumnNames="usuario_id" baseTableName="entregador" constraintName="fk_entregador_usuario" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="usuario" validate="true" />
        <addForeignKeyConstraint baseColumnNames="restaurante_id" baseTableName="item_cardapio" constraintName="fk_item_cardapio_restaurante" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="restaurante" validate="true" />
        <addForeignKeyConstraint baseColumnNames="item_cardapio_id" baseTableName="item_pedido" constraintName="fk_item_pedido_cardapio" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="item_cardapio" validate="true" />
        <addForeignKeyConstraint baseColumnNames="pedido_id" baseTableName="item_pedido" constraintName="fk_item_pedido_pedido" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="pedido" validate="true" />
        <addForeignKeyConstraint baseColumnNames="pedido_id" baseTableName="pagamento" constraintName="fk_pagamento_pedido" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="pedido" validate="true" />
        <addForeignKeyConstraint baseColumnNames="cliente_id" baseTableName="pedido" constraintName="fk_pedido_cliente" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="usuario_id" referencedTableName="cliente" validate="true" />
        <addForeignKeyConstraint baseColumnNames="endereco_entrega_id" baseTableName="pedido" constraintName="fk_pedido_endereco" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="endereco_entrega" validate="true" />
        <addForeignKeyConstraint baseColumnNames="entregador_id" baseTableName="pedido" constraintName="fk_pedido_entregador" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="usuario_id" referencedTableName="entregador" validate="true" />
        <addForeignKeyConstraint baseColumnNames="restaurante_id" baseTableName="pedido" constraintName="fk_pedido_restaurante" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="restaurante" validate="true" />
        <addForeignKeyConstraint baseColumnNames="categoria_id" baseTableName="restaurante" constraintName="fk_restaurante_categoria" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="id" referencedTableName="categoria_restaurante" validate="true" />
        <addForeignKeyConstraint baseColumnNames="dono_id" baseTableName="restaurante" constraintName="fk_restaurante_dono" deferrable="false" initiallyDeferred="false" onDelete="NO ACTION" onUpdate="NO ACTION" referencedColumnNames="usuario_id" referencedTableName="dono_restaurante" validate="true" />
    </changeSet>

</databaseChangeLog>
