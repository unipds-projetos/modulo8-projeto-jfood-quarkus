            </column>
            <column name="preco_unitario" type="numeric(10, 2)">
                <constraints nullable="false" />
            </column>
        </createTable>
        <addUniqueConstraint columnNames="pedido_id, item_cardapio_id" constraintName="item_pedido_pedido_id_item_cardapio_id_key" tableName="item_pedido" />
    </changeSet>

<changeSet id="1-pagamento" author="jfood" labels="schema">
        <createTable tableName="pagamento">
