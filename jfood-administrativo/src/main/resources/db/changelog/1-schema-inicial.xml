            <column defaultValueBoolean="true" name="disponivel" type="BOOLEAN">
                <constraints nullable="false" />
            </column>
        </createTable>
    </changeSet>

<changeSet id="1-pedido" author="jfood" labels="schema">
        <createTable tableName="pedido">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="pedido_pkey" />
            </column>
            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="restaurante_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="endereco_entrega_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="entregador_id" type="BIGINT" />
            <column defaultValue="CRIADO" name="status" type="VARCHAR(20)">
                <constraints nullable="false" />
            </column>
            <column defaultValueComputed="now()" name="data_pedido" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false" />
            </column>
            <column defaultValueNumeric="0" name="valor_total" type="numeric(10, 2)">
                <constraints nullable="false" />
            </column>
            <column name="observacao" type="VARCHAR(255)" />
        </createTable>
    </changeSet>

<changeSet id="1-item_pedido" author="jfood" labels="schema">
        <createTable tableName="item_pedido">
            <column autoIncrement="true" name="id" type="BIGINT">
