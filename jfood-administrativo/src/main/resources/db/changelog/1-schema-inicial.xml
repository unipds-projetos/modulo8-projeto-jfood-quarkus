            </column>
        </createTable>
        <addUniqueConstraint columnNames="cliente_id, apelido" constraintName="endereco_entrega_cliente_id_apelido_key" tableName="endereco_entrega" />
    </changeSet>

<changeSet id="1-categoria_restaurante" author="jfood" labels="schema">
        <createTable tableName="categoria_restaurante">
            <column autoIncrement="true" name="id" type="INTEGER">
                <constraints nullable="false" primaryKey="true" primaryKeyName="categoria_restaurante_pkey" />
            </column>
            <column name="nome" type="VARCHAR(50)">
                <constraints nullable="false" />
            </column>
        </createTable>
        <addUniqueConstraint columnNames="nome" constraintName="categoria_restaurante_nome_key" tableName="categoria_restaurante" />
    </changeSet>

<changeSet id="1-restaurante" author="jfood" labels="schema">
        <createTable tableName="restaurante">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="restaurante_pkey" />
            </column>
            <column name="nome" type="VARCHAR(120)">
                <constraints nullable="false" />
            </column>
            <column name="categoria_id" type="INTEGER">
                <constraints nullable="false" />
            </column>
            <column name="dono_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="cep" type="VARCHAR(8)">
                <constraints nullable="false" />
            </column>
            <column defaultValueComputed="now()" name="criado_em" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false" />
            </column>
