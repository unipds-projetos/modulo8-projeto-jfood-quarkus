        <addUniqueConstraint columnNames="cnpj" constraintName="dono_restaurante_cnpj_key" tableName="dono_restaurante" />
    </changeSet>

<changeSet id="1-endereco_entrega" author="jfood" labels="schema">
        <createTable tableName="endereco_entrega">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="endereco_entrega_pkey" />
            </column>
            <column name="cliente_id" type="BIGINT">
                <constraints nullable="false" />
            </column>
            <column name="apelido" type="VARCHAR(30)">
                <constraints nullable="false" />
            </column>
            <column name="cep" type="VARCHAR(8)">
                <constraints nullable="false" />
            </column>
            <column name="logradouro" type="VARCHAR(150)">
                <constraints nullable="false" />
            </column>
            <column name="numero" type="VARCHAR(10)">
                <constraints nullable="false" />
            </column>
            <column name="complemento" type="VARCHAR(60)" />
            <column name="bairro" type="VARCHAR(100)">
                <constraints nullable="false" />
            </column>
            <column name="cidade" type="VARCHAR(100)">
                <constraints nullable="false" />
            </column>
            <column name="uf" type="CHAR(2)">
