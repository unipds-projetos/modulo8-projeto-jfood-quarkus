<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
      UM CHANGESET POR TABELA, e nao um para o esquema inteiro.
      A granularidade e a do rollback: com doze changesets da para voltar
      uma tabela; com um so, o rollback e tudo ou nada.

      E o DDL some. Quem escreve o CREATE TABLE agora e o Liquibase, para o
      banco alvo  a mesma definicao roda em PostgreSQL, MySQL ou Oracle.
      O preco esta na migracao 4.
    -->

<changeSet id="1-usuario" author="jfood" labels="schema">
        <createTable tableName="usuario">
            <column autoIncrement="true" name="id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="usuario_pkey" />
            </column>
            <column name="nome" type="VARCHAR(100)">
                <constraints nullable="false" />
            </column>
            <column name="email" type="VARCHAR(150)">
                <constraints nullable="false" />
            </column>
            <column name="senha_hash" type="VARCHAR(60)">
                <constraints nullable="false" />
            </column>
            <column name="telefone" type="VARCHAR(20)" />
            <column defaultValueComputed="now()" name="criado_em" type="TIMESTAMP WITH TIME ZONE">
                <constraints nullable="false" />
            </column>
        </createTable>
        <addUniqueConstraint columnNames="email" constraintName="usuario_email_key" tableName="usuario" />
    </changeSet>

<changeSet id="1-cliente" author="jfood" labels="schema">
        <createTable tableName="cliente">
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="cliente_pkey" />
            </column>
            <column name="cpf" type="VARCHAR(11)">
                <constraints nullable="false" />
            </column>
        </createTable>
        <addUniqueConstraint columnNames="cpf" constraintName="cliente_cpf_key" tableName="cliente" />
    </changeSet>

<changeSet id="1-entregador" author="jfood" labels="schema">
        <createTable tableName="entregador">
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="entregador_pkey" />
            </column>
            <column name="cnh" type="VARCHAR(11)">
                <constraints nullable="false" />
            </column>
            <column name="tipo_veiculo" type="VARCHAR(20)">
                <constraints nullable="false" />
            </column>
            <column defaultValueBoolean="true" name="disponivel" type="BOOLEAN">
                <constraints nullable="false" />
            </column>
        </createTable>
        <addUniqueConstraint columnNames="cnh" constraintName="entregador_cnh_key" tableName="entregador" />
    </changeSet>

<changeSet id="1-dono_restaurante" author="jfood" labels="schema">
        <createTable tableName="dono_restaurante">
            <column name="usuario_id" type="BIGINT">
                <constraints nullable="false" primaryKey="true" primaryKeyName="dono_restaurante_pkey" />
            </column>
